{
  "name": "prettier-plugin-properties",
  "version": "0.3.1",
  "license": "MIT",
  "author": "Eemeli Aro <eemeli@gmail.com>",
  "description": "Prettier plugin for .properties files",
  "keywords": [
    "prettier",
    "properties",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/eemeli/prettier-plugin-properties/issues"
  },
  "homepage": "https://github.com/eemeli/prettier-plugin-properties#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eemeli/prettier-plugin-properties.git"
  },
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "languages.js",
    "ThirdPartyNoticeText.txt"
  ],
  "scripts": {
    "prepare": "node scripts/languages",
    "prettier": "prettier --write .",
    "test": "vitest run --coverage"
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "dependencies": {
    "dot-properties": "^1.1.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "linguist-languages": "^9.5.0",
    "prettier": "^3.10.1",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "prettier": ">= 2.3.0"
  }
}
